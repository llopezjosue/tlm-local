# Configuration template. Copy to .env before running the backend:
#   cp env.example .env
#
# No API key of any kind is required. Everything points at a local Ollama
# server, and nothing in this project reaches the internet at runtime.
#
# For why these particular models and this preset were chosen, see
# docs/JOURNAL.md. For what each tlm setting actually does, see
# tlm_local/CONFIG_REFERENCE.md and docs/SCORING.md.

# Chatbot persona. Optional: with no value set, the backend is a plain generic
# assistant. The example below is this repo's demo persona, replace it with
# anything.
SYSTEM_PROMPT=You are a sports coach with expertise in fitness, strength training, running and sports nutrition. Only answer questions related to sport, physical training and sports nutrition. If a question falls outside that domain, politely say that you only answer sport/fitness questions. Be concise and concrete.

# Where the local Ollama server is running.
OLLAMA_API_BASE=http://localhost:11434

# Model that generates the chat answers.
GENERATOR_MODEL=ollama/ministral-3:3b

# Model tlm uses as its judge (self-reflection scoring). Keep the "ollama/"
# prefix so litellm routes it locally, and set it before starting the process:
# tlm caches this value on its first import.
DEFAULT_MODEL=ollama/qwen2.5:7b

# Scoring depth: base | low | medium | high | best
# medium is self-reflection only. high and best add consistency sampling, which
# costs more latency and shifts the score's calibration, so switching means
# retuning the trust-label thresholds in backend/app/config.py.
TLM_QUALITY_PRESET=medium

# How much the judge deliberates before scoring: none | low | medium | high
# Defaults to none for this workflow, meaning the judge emits a number with no
# reasoning step. Raising it makes tlm's `explanation` field carry real critique
# instead of a fixed "Did not find a reason to doubt trustworthiness", at about
# +30% latency. Measured effect on the score itself is promising but not yet
# conclusive; see docs/SCORING.md.
# TLM_REASONING_EFFORT=high

# Not a .env setting, but it matters: start Ollama with OLLAMA_NUM_PARALLEL=4
# (e.g. `OLLAMA_NUM_PARALLEL=4 ollama serve`) or a scored request takes 2-3x
# longer. It has to be set on every Ollama start.
