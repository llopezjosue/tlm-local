# Configuration template. Copy to .env before running the backend:
#   cp env.example .env
#
# No API key of any kind is required. Everything points at a local Ollama
# server, and nothing in this project reaches the internet at runtime.
#
# Two groups below. The first is read by the tlm_local package, so it applies
# whether you run the showcase app or import the wrapper into your own project.
# The second is read only by the showcase backend.


# ---------------------------------------------------------------------------
# Read by tlm_local
# ---------------------------------------------------------------------------

# Where the local Ollama server is running.
OLLAMA_API_BASE=http://localhost:11434

# Model that generates the chat answers.
GENERATOR_MODEL=ollama/ministral-3:3b

# Model tlm uses as its judge (self-reflection scoring). Keep the "ollama/"
# prefix so litellm routes it locally, and set it before starting the process:
# tlm caches this value on its first import. Without it, tlm falls back to a
# hosted model and LocalTLM refuses to construct rather than let prompts leave.
DEFAULT_MODEL=ollama/qwen2.5:7b

# Scoring depth: base | low | medium | high | best
# medium is self-reflection plus perplexity. high and best add consistency
# sampling, which costs latency and shifts the score's composition, so switching
# means recalibrating any trust thresholds. base and low are identical to medium.
TLM_QUALITY_PRESET=medium

# How much the judge deliberates before scoring: none | low | medium | high
# Unset means tlm's own default, which is none for this workflow: the judge emits
# a number with no reasoning step. Raising it makes tlm's `explanation` carry real
# critique instead of a fixed string, and switches the judge to a prompt that
# reasons before rating, so it moves the score too. Neither that shift nor its
# latency cost has been measured here; see docs/SCORING.md.
# TLM_REASONING_EFFORT=high

# How the consistency signal compares alternate answers:
# jaccard | code | statement | embedding_small | embedding_large
# Unset means tlm picks per workflow (statement for QA). Inert below
# quality_preset=high, since consistency runs no completions at medium. The
# embedding_* values are the one tlm code path that calls hosted OpenAI, and the
# showcase app refuses them for that reason.
# TLM_SIMILARITY_MEASURE=statement


# ---------------------------------------------------------------------------
# Read by the showcase app only (backend/)
# ---------------------------------------------------------------------------

# Chatbot persona. Optional: with no value set, the backend is a plain generic
# assistant. The example below is this repo's demo persona, replace it with
# anything. Note it reaches the judge as well as the generator.
SYSTEM_PROMPT=You are a sports coach with expertise in fitness, strength training, running and sports nutrition. Only answer questions related to sport, physical training and sports nutrition. If a question falls outside that domain, politely say that you only answer sport/fitness questions. Be concise and concrete.

# How many scored requests run at once; the rest queue. One scored request
# already fans out to about seven concurrent Ollama calls, so the default of 1 is
# deliberate: two at a time push judge calls into timeouts, and a failed judge
# call takes the whole score down. Raise it only together with
# OLLAMA_NUM_PARALLEL below.
# MAX_CONCURRENT_CHATS=1

# Upper bound on the question's length in characters. It is not sent once: it
# goes to the generator, then into each of the six judge prompts, so a long
# question is paid for seven times over.
# MAX_QUESTION_CHARS=4000

# Upper bound on a request's max_tokens. The six judge calls all re-read the
# answer, so its length is multiplied through the scoring pass.
# MAX_TOKENS_LIMIT=4096


# Not a .env setting, but worth knowing: OLLAMA_NUM_PARALLEL is set when
# starting Ollama (e.g. `OLLAMA_NUM_PARALLEL=4 ollama serve`) and has to be set
# again on every start. It cuts latency sharply where an accelerator serves the
# models, and buys nothing on CPU alone while costing memory. See the README.
